# --- Generated checksum baselines from the README walkthrough ---
checksums.sha256
baseline.txt
current.txt

# --- Week 2: baseline artifacts ---
# baseline.json IS committed on purpose (it is the sample baseline).
# Only the atomic-write temp file and any alternate baselines are ignored.
baseline.json.tmp
*.json.tmp
other.json
my.json
legacy.json
bad.json
arr.json

# --- pytest artifacts ---

# --- Week 3: runtime output from `watch` ---
# The log is generated at runtime; never commit it.
filewatch.log
*.log
!filewatch.log.template

# Optional HMAC signing keys (stretch goal) must never be committed
*.key
*.hmac
hmac.key

# --- Temporary demonstration leftovers (should never be committed) ---
test_folder/demo_copy_*

# --- OS metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

